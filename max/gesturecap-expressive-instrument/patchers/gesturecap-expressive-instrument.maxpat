                                                }
                                            },
                                            {
                                                "box": {
                                                    "code": "//====================================================\n// Universal Wavetable Morph Reader\n// Automatically detects frame count from buffer length\n// buffer~ wt\n//====================================================\n\nBuffer wt;\n\nParam freq(55);\nParam pitch(0);\nParam shape(0);\nParam level(1);\nParam smooth(0.001);\n\nHistory s_smooth(0);\n\nTABLE_SIZE = 1024;\n\n// Detect buffer length and frame count\nbuffer_length = dim(wt);\nframe_count = max(1, floor(buffer_length / TABLE_SIZE));\n\n// Pitch\npitch_c = clamp(pitch, -1200, 1200);\nratio = pow(2, pitch_c / 1200);\nf = freq * ratio;\n\n// Oscillator phase\np = phasor(f);\n\n// Smooth wavetable position\ns_target = clamp(shape, 0, 1);\ns_smooth = mix(s_smooth, s_target, smooth);\ns = s_smooth;\n\n// Select neighboring frames\nframe_pos = s * (frame_count - 1);\nframe_a = floor(frame_pos);\nframe_b = min(frame_a + 1, frame_count - 1);\nframe_mix = frame_pos - frame_a;\n\n// Select neighboring samples inside each frame\nsample_pos = p * (TABLE_SIZE - 1);\nsample_a = floor(sample_pos);\nsample_b = min(sample_a + 1, TABLE_SIZE - 1);\nsample_mix = sample_pos - sample_a;\n\n// Convert frame/sample coordinates to buffer indices\nidx_a0 = frame_a * TABLE_SIZE + sample_a;\nidx_a1 = frame_a * TABLE_SIZE + sample_b;\n\nidx_b0 = frame_b * TABLE_SIZE + sample_a;\nidx_b1 = frame_b * TABLE_SIZE + sample_b;\n\n// Read buffer\na0 = peek(wt, idx_a0, 0);\na1 = peek(wt, idx_a1, 0);\n\nb0 = peek(wt, idx_b0, 0);\nb1 = peek(wt, idx_b1, 0);\n\n// Interpolate inside each frame\nwave_a = mix(a0, a1, sample_mix);\nwave_b = mix(b0, b1, sample_mix);\n\n// Interpolate between frames\ny = mix(wave_a, wave_b, frame_mix);\n\n// Output\nout1 = y * level;",
                                                    "fontface": 0,
                                                    "fontname": "<Monospaced>",
                                                    "fontsize": 12.0,
                                                    "id": "obj-2",
                                                    "maxclass": "codebox",
                                                    "numinlets": 1,
                                                    "numoutlets": 1,
                                                    "outlettype": [ "" ],
                                                    "patching_rect": [ 185.0, 51.0, 1025.0, 687.0 ]
                                                }
                                            }
